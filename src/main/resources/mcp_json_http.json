{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "Authorization": "Bearer ${input:github_token}",
        "Content-Type": "application/json"
      },
      "timeout": 30
    },
    "jira": {
      "type": "http",
      "url": "https://mcp-jira.example.com",
      "headers": {
        "Authorization": "Bearer ${env:JIRA_API_TOKEN}",
        "Content-Type": "application/json"
      },
      "config": {
        "jiraUrl": "${env:JIRA_URL}",
        "username": "${env:JIRA_USERNAME}"
      },
      "timeout": 45
    },
    "slack": {
      "type": "http",
      "url": "https://mcp-slack.company.com/api/mcp",
      "headers": {
        "Authorization": "Bearer ${input:slack_token}",
        "X-Slack-Workspace": "${input:slack_workspace}"
      },
      "timeout": 30
    }
  },
  "inputs": {
    "github_token": "ghp_your_github_personal_access_token_here",
    "slack_token": "xoxb-your-slack-bot-token-here",
    "slack_workspace": "your-workspace"
  }
}


